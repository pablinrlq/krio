# Domínio do site, já apontado (registro A) para o IP do servidor.
DOMAIN=krio.com.br

# Senha do banco de dados (invente uma longa).
POSTGRES_PASSWORD=troque-esta-senha

# Chave para cifrar sessões e tokens das redes. 32+ caracteres aleatórios.
# Gere com: openssl rand -hex 32
APP_SECRET=

# Primeiro administrador da KRIÔ (criado ao subir o servidor).
ADMIN_EMAIL=equipe@krio.com.br
ADMIN_PASSWORD=

# E-mails de aviso (SMTP). Ex.: smtps://usuario:senha@smtp.provedor.com:465
SMTP_URL=
MAIL_FROM=KRIÔ <nao-responda@krio.com.br>

# Login com Google + YouTube (console.cloud.google.com → Credenciais → OAuth).
# URIs de redirecionamento autorizados:
#   https://SEU_DOMINIO/api/auth/google/retorno
#   https://SEU_DOMINIO/api/redes/youtube/retorno
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Instagram API com login do Instagram (developers.facebook.com).
# Redirect: https://SEU_DOMINIO/api/redes/instagram/retorno
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=

# TikTok Login Kit (developers.tiktok.com).
# Redirect: https://SEU_DOMINIO/api/redes/tiktok/retorno
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# Tamanho máximo de arquivo enviado no chat, em MB.
UPLOAD_LIMIT_MB=200
